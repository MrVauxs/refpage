# Drizzle
# In production point this inside the mounted volume /data/db/refpage.db
DATABASE_URL=local.db

# In production point this inside the mounted volume /data/uploads
UPLOAD_DIR=uploads

# No ORIGIN here on purpose: adapter-node inlines it at build time, and the
# deployed server takes the origin from the proxy's x-forwarded-proto /
# x-forwarded-host headers instead. Setting it at runtime breaks /api/auth/*.

# Comma-separated public hostnames, no scheme, e.g. refs.example.com
# (wildcards like *.example.com work). Only needed for OAuth sign-in, which
# needs an absolute callback URL. Leave unset for email and password only.
ALLOWED_HOSTS=""

# Better Auth
BETTER_AUTH_SECRET=""
# GitHub OAuth
# Callback URL to register on GitHub: https://<host>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# adapter-node
# PORT=3000
# HOST=0.0.0.0
# Maximum request body size; the 512K default is too small for image uploads
# BODY_SIZE_LIMIT=25M
