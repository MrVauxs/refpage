# Drizzle
# In production point this inside the mounted volume /data/db/refpage.db
DATABASE_URL=local.db

# In production point this inside the mounted volume /data/uploads
UPLOAD_DIR=uploads

# Public base URL. Optional behind a reverse proxy (Coolify sets
# x-forwarded-proto / x-forwarded-host, which the server uses instead).
ORIGIN=""

# Better Auth
BETTER_AUTH_SECRET=""
# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# adapter-node
# PORT=3000
# HOST=0.0.0.0
# Maximum request body size; the 512K default is too small for image uploads
# BODY_SIZE_LIMIT=25M
